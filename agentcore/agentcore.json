  "agentCoreGateways": [
    {
      "name": "ppfraud-reference",
      "protocolType": "MCP",
      "description": "Reference-data tools for the fraud agents, MCP-ified behind one endpoint. Today the alert dictionary; the same gateway is where an Aurora or Cortex target goes.",
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "targets": [
        {
          "name": "AlertDictionary",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:269550163595:function:PpFraudReferenceTools-AlertDictionary-jnrqpQzEuk0S",
            "toolSchemaFile": "agentcore/tool/alert_dictionary_schema.json"
          }
        },
        {
          "name": "UnderwritingSql",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:269550163595:function:PpFraudRdsTools-UnderwritingSql-28zT4I2S0p25",
