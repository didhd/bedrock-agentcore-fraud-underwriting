      "entrypoint": "main.py",
      "codeLocation": "app/underwriter/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "MOCK_MODE",
          "value": "0"
        },
        {
          "name": "FANOUT_MODE",
          "value": "distributed"
        },
        {
          "name": "AURORA_CLUSTER_ARN",
          "value": "arn:aws:rds:us-west-2:269550163595:cluster:ppfrauddata-clustereb0386a7-rgfx8gqmhj1l"
        },
        {
          "name": "AURORA_SECRET_ARN",
