  "memories": [
    {
      "name": "francisMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "name": "analystFacts",
          "description": "Facts an analyst states about themselves or their work -- which lender they cover, which fraud discipline they own, which applications they are reviewing. Retrieved on later sessions so a returning analyst does not restate them.",
          "namespaceTemplates": [
            "/analysts/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "name": "caseSummaries",
          "description": "A compressed summary of each review session, so a case picked up tomorrow carries what was already established rather than starting from the application record again.",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
